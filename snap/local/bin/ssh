#!/bin/sh
set -eu

umask 077
ssh_dir="$SNAP_USER_COMMON/ssh"
mkdir -p "$ssh_dir"
chmod 700 "$ssh_dir"

# Keep newly trusted hosts in writable snap data and retain existing host trust.
exec "$SNAP/usr/bin/ssh" \
  -o "UserKnownHostsFile=\"$ssh_dir/known_hosts\" \"${SNAP_REAL_HOME:-$HOME}/.ssh/known_hosts\" \"${SNAP_REAL_HOME:-$HOME}/.ssh/known_hosts2\"" \
  "$@"
